# Copy this file to .env and edit the values for manual E2E testing.
# Load it with: set -a; source .env; set +a
# bzz does not load .env files automatically.
#
# Never add an nsec, secret key, passphrase, or relay private key here.

# Binary under test.
BZZ_BIN=./target/release/bzz

# Isolated local state used by bzz itself.
BZZ_E2E_ROOT=/tmp/bzz-e2e
BZZ_CONFIG_DIR=/tmp/bzz-e2e/config
BZZ_DATA_DIR=/tmp/bzz-e2e/data
BZZ_CACHE_DIR=/tmp/bzz-e2e/cache

# Manual test labels and relay endpoint (shell helpers, not read directly by bzz).
BZZ_IDENTITY_LABEL=e2e-manual
BZZ_IDENTITY_BACKEND=keychain
BZZ_COMMUNITY_LABEL=e2e
BZZ_RELAY_URL=wss://buzz.example
BZZ_ALLOW_INSECURE_LOCALHOST=0

# Fill these non-secret values after creating the identity/community.
BZZ_IDENTITY_ID=
BZZ_PUBLIC_KEY=
BZZ_COMMUNITY_ID=

# Pinned block/buzz checkout used by scripts/test-relay.sh.
BZZ_BUZZ_SOURCE=/path/to/block/buzz

# Keep disabled unless intentionally testing a different Buzz revision.
BZZ_ALLOW_UNPINNED_RELAY=0

# Optional v0.9 controlled telemetry canary. bzz reads only BZZ_OTEL_TOKEN as
# an ephemeral credential; the endpoint is passed explicitly to `telemetry
# configure`. Leave both empty for ordinary E2E and never commit a real token.
BZZ_OTEL_ENDPOINT=https://operator.example/v1/logs
BZZ_OTEL_TOKEN=
